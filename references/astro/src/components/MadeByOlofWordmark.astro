---
interface Props { href?: string; showTagline?: boolean }
const { href = 'https://www.madebyolof.com/', showTagline = false } = Astro.props;
---
<a class="maker-wordmark" href={href} aria-label="Made by Olof — visit the creator's website">
  <span class="maker-row">
    <span class="maker-text"><span class="maker-prefix">Made by</span> <span class="maker-name">Olof</span></span>
    <img class="maker-portrait" src="/branding/made-by-olof/portrait.webp" width="32" height="32" alt="" loading="lazy" />
  </span>
  {showTagline && <span class="maker-tagline">Founder and Builder</span>}
</a>
<style>
  @font-face {
    font-family: 'Maker Lora';
    src: url('/branding/made-by-olof/lora-latin-italic.woff2') format('woff2');
    font-style: italic;
    font-weight: 400 700;
    font-display: swap;
  }
  .maker-wordmark {
    display: inline-flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    gap: .2rem;
    min-height: 44px;
    padding-block: .3rem;
    color: inherit;
    text-decoration: none;
    white-space: nowrap;
    border-radius: 4px;
    transition: opacity 150ms;
  }
  .maker-wordmark:hover { opacity: .75; }
  .maker-wordmark:focus-visible { outline: 2px solid currentColor; outline-offset: 4px; }
  .maker-row { display: inline-flex; align-items: center; gap: .5rem; }
  .maker-text {
    display: inline-flex;
    align-items: baseline;
    gap: .3rem;
    font-family: 'Maker Lora', Georgia, serif;
    font-style: italic;
    font-weight: 600;
    font-synthesis: none;
    letter-spacing: -.035em;
    line-height: 1.2;
  }
  .maker-prefix { font-size: 15px; }
  .maker-name { font-size: 26px; }
  .maker-portrait { width: 30px; height: 30px; border-radius: 50%; object-fit: cover; }
  .maker-tagline { font-family: system-ui, sans-serif; font-size: 12px; font-weight: 400; line-height: 1.5; }
</style>
